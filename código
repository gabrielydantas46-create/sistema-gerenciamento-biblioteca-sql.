SELECT * FROM livros
WHERE titulo LIKE 'A%';

SELECT
    leitores.nome,
    livros.titulo,
    emprestimos.data_emprestimo
FROM emprestimos
INNER JOIN leitores
ON emprestimos.id_leitor = leitores.id_leitor
INNER JOIN livros
ON emprestimos.id_livro = livros.id_livro;

SELECT * FROM livros
WHERE disponivel = TRUE;

SELECT COUNT(*) AS quantidade_livros
FROM livros;
